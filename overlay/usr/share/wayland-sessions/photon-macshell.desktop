[Desktop Entry]
Name=PhotonOS MacShell
Name[ru]=PhotonOS MacShell
Comment=macOS Tahoe-style desktop: Hyprland + Quickshell MacShell
Comment[ru]=Рабочий стол в стиле macOS Tahoe: Hyprland + Quickshell MacShell
# WLR_NO_HARDWARE_CURSORS/AQ_NO_MODIFIERS — безвредны на реальном GPU,
# обязательны в виртуалке (QEMU/боз-драйвер, llvmpipe/lavapipe)
Exec=env WLR_NO_HARDWARE_CURSORS=1 AQ_NO_MODIFIERS=1 Hyprland
Type=Application
DesktopNames=Hyprland;MacShell
Keywords=macshell;hyprland;photon

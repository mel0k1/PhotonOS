[Icon Theme]
Name=photon
Comment=PhotonOS: brand icons on top of Papirus (menu logo, Recent documents, File manager)
Comment[ru]=PhotonOS: фирменные значки поверх Papirus (логотип меню, Недавние документы, Файловый менеджер). Корзина и остальное — из Papirus
Inherits=Papirus

# Растровые размеры + вектор (логотип меню). Остальное Papirus (SVG)
# отдаёт по наследству — включая user-trash: авторская «корзинка» убрана.
Directories=24x24/apps,24x24/actions,32x32/apps,32x32/actions,48x48/apps,48x48/actions,64x64/apps,64x64/actions,128x128/apps,128x128/actions,256x256/apps,256x256/actions,scalable/apps

[scalable/apps]
Size=48
Scale=1
Context=Applications
Type=Scalable
MinSize=8
MaxSize=512

[24x24/apps]
Size=24
Context=Applications
Type=Threshold

[24x24/actions]
Size=24
Context=Actions
Type=Threshold

[32x32/apps]
Size=32
Context=Applications
Type=Threshold

[32x32/actions]
Size=32
Context=Actions
Type=Threshold


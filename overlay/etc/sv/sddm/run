#!/bin/sh
exec 2>&1
set -e
sv check dbus >/dev/null || exit 1

if [ -x /usr/bin/elogind-inhibit ]; then
        dbus-send --system --print-reply --dest=org.freedesktop.DBus \
                /org/freedesktop/DBus                           \
                org.freedesktop.DBus.StartServiceByName         \
                string:org.freedesktop.login1 uint32:0
fi

# respect system locale
[ -r /etc/locale.conf ] && . /etc/locale.conf && export LANG

# PhotonOS (live): mklive создаёт пользователя anon до наложения оверлея,
# поэтому свежесозданный /home/anon не получает /etc/skel (MacShell-конфиги,
# hyprland.lua, обои). Досыпаем дефолты без перезаписи и чиним владельца.
# На установленной системе /home/anon отсутствует — ветка не срабатывает,
# а новые пользователи получают skel штатно через useradd -m.
if [ -d /home/anon ] && [ -d /etc/skel ]; then
    cp -rn /etc/skel/. /home/anon/ 2>/dev/null || true
    chown -R anon:anon /home/anon 2>/dev/null || true
fi

[ -f ./conf ] && . ./conf

exec sddm 2>&1

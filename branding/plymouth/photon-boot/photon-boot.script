# photon-boot — загрузочная анимация PhotonOS
# Циклически проигрывает кадры фирменного ролика (70 кадров, сняты 15 fps)
# на фоне цвета кадра (#030303). Кадры вписываются в экран с сохранением
# пропорций, поэтому тема корректна на любых разрешениях и в 16:9, и в 4:3.

# Window - глобал script-плагина (window в нижнем регистре = ошибка рантайма,
# тема молча не рисует и остаётся текст консоли).
Window.SetBackgroundTopColor(0.012, 0.012, 0.012);
Window.SetBackgroundBottomColor(0.012, 0.012, 0.012);

n_frames = 70;
divider = 4;   # тиков refresh на один кадр: ~15 fps при ~60 Гц
frame = 0;
tick = 0;

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

first = Image("frame0.png");
img_w = first.GetWidth();
img_h = first.GetHeight();

scale = 1.0;
if (img_w > screen_w) {
    scale = screen_w / img_w;
}
draw_w = img_w * scale;
draw_h = img_h * scale;

sprite = Sprite(first);
sprite.SetPosition((screen_w - draw_w) / 2, (screen_h - draw_h) / 2, 10000);

fun refresh() {
    tick = tick + 1;
    if (tick >= divider) {
        tick = 0;
        frame = frame + 1;
        if (frame >= n_frames) {
            frame = 0;
        }
        sprite.SetImage(Image("frame" + frame + ".png"));
    }
}

Plymouth.SetRefreshFunction(refresh);

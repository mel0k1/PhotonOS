#!/bin/sh
# ppm - Photon Package Manager (обёртка над XBPS; порт на apt в работе).
# Лицензия: GPL-3.0+. Подробности: docs/PPM.md

VERSION="0.1.0"

# ---------- вывод ----------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_ICON='\033[36m'
    C_OK='\033[32m'
    C_WARN='\033[33m'
    C_ERR='\033[31m'
    C_TXT='\033[1m'
    C_OFF='\033[0m'
else
    C_ICON=''
    C_OK=''
    C_WARN=''
    C_ERR=''
    C_TXT=''
    C_OFF=''
fi

# служебные сообщения идут в stderr: stdout остаётся чистым для xbps
msg()  { printf '%b==> %b%s%b\n' "$C_ICON" "$C_TXT" "$1" "$C_OFF" >&2; }
warn() { printf '%b>> %s%b\n' "$C_WARN" "$1" "$C_OFF" >&2; }
die()  { printf '%b!! %s%b\n' "$C_ERR" "$1" "$C_OFF" >&2; exit 1; }

# ---------- проверки ----------
need_xbps() {
    command -v xbps-install >/dev/null 2>&1 \
        || die "ppm работает на системах с XBPS (PhotonOS / Void Linux)"
}

need_root() {
    [ "$(id -u)" -eq 0 ] || die "нужны права root: sudo ppm $1"
}

# ---------- логотип и справка ----------
print_art() {
    printf '%b' "$C_ICON"
    cat <<'ART'
                                   
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@* 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@*.....@@@@@@@@@@@@@@@@.....%@@% 
 @@*.....@@@@@@@@@@@@@@@@.....%@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 +@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@  
ART
    printf '%b' "$C_OFF"
}

usage() {
    print_art
    cat <<EOF
  ppm $VERSION — Photon Package Manager (обёртка над XBPS)

  Использование: ppm <команда> [аргументы]

  Команды:
    install <пакеты>  установить пакеты             -> xbps-install -S
    remove  <пакеты>  удалить пакеты и зависимости  -> xbps-remove -R
    search  <запрос>  искать по репозиториям        -> xbps-query -Rs
    info    <пакет>   подробности о пакете          -> xbps-query -R
    sync              синхронизировать индексы репозиториев
    update            обновить систему целиком
    autoremove        удалить пакеты-сироты
    clean             очистить кэш скачанных пакетов
    list              список установленных пакетов
    about             о программе
    help              эта справка

  Синонимы: i=install  r=remove  s=search  up=update
  Аргументы передаются xbps как есть: ppm install -y firefox

  Примеры:
    ppm sync && ppm update
    ppm install firefox noto-fonts-ttf
    ppm search terminal
EOF
}

about() {
    print_art
    printf '  ppm %s — Photon Package Manager\n' "$VERSION"
    printf '  PhotonOS | Void Linux (glibc) + runit | лицензия GPL-3.0\n'
    printf '  https://github.com/mel0k1/PhotonOS\n'
}

# ---------- команды ----------
[ $# -ge 1 ] || { usage; exit 0; }
CMD=$1
shift

case "$CMD" in
    install|i)
        need_xbps
        need_root install
        [ $# -ge 1 ] || die "укажи пакеты: ppm install <пакеты>"
        msg "устанавливаю: $*"
        xbps-install -S "$@"
        exit $?
        ;;
    remove|r|rm)
        need_xbps
        need_root remove
        [ $# -ge 1 ] || die "укажи пакеты: ppm remove <пакеты>"
        msg "удаляю: $*"
        xbps-remove -R "$@"
        exit $?
        ;;
    search|s)
        need_xbps
        [ $# -ge 1 ] || die "укажи запрос: ppm search <запрос>"
        xbps-query -Rs "$@"
        exit $?
        ;;
    info)
        need_xbps
        [ $# -ge 1 ] || die "укажи пакет: ppm info <пакет>"
        xbps-query -R "$@"
        exit $?
        ;;
    sync)
        need_xbps
        need_root sync
        msg "синхронизирую индексы репозиториев"
        xbps-install -S
        exit $?
        ;;
    update|upgrade|up)
        need_xbps
        need_root update
        msg "обновляю систему"
        xbps-install -Su
        exit $?
        ;;
    autoremove)
        need_xbps
        need_root autoremove
        msg "удаляю пакеты-сироты"
        xbps-remove -O
        exit $?
        ;;
    clean)
        need_xbps
        need_root clean
        msg "очищаю кэш скачанных пакетов"
        xbps-remove -m
        exit $?
        ;;
    list|ls)
        need_xbps
        xbps-query -l
        exit $?
        ;;
    about|version|-v|--version)
        about
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        die "неизвестная команда: $CMD (справка: ppm help)"
        ;;
esac

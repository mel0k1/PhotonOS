#!/bin/sh
# ppm - Photon Package Manager (обёртка над apt).
# Лицензия: GPL-3.0+. Подробности: docs/PPM.md

VERSION="0.2.0"

# ---------- вывод ----------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_ICON='\033[36m'
    C_OK='\033[32m'
    C_WARN='\033[33m'
    C_ERR='\033[31m'
    C_TXT='\033[1m'
    C_OFF='\033[0m'
else
    C_ICON=''
    C_OK=''
    C_WARN=''
    C_ERR=''
    C_TXT=''
    C_OFF=''
fi

# служебные сообщения идут в stderr: stdout остаётся чистым для apt
msg()  { printf '%b==> %b%s%b\n' "$C_ICON" "$C_TXT" "$1" "$C_OFF" >&2; }
warn() { printf '%b>> %s%b\n' "$C_WARN" "$1" "$C_OFF" >&2; }
die()  { printf '%b!! %s%b\n' "$C_ERR" "$1" "$C_OFF" >&2; exit 1; }

# ---------- проверки ----------
need_apt() {
    command -v apt-get >/dev/null 2>&1 \
        || die "ppm работает на системах с apt (PhotonOS / Debian)"
}

need_root() {
    [ "$(id -u)" -eq 0 ] || die "нужны права root: sudo ppm $1"
}

# ---------- логотип и справка ----------
print_art() {
    printf '%b' "$C_ICON"
    cat <<'ART'
                                   
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@* 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@*.....@@@@@@@@@@@@@@@@.....%@@% 
 @@*.....@@@@@@@@@@@@@@@@.....%@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@% 
 +@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@  
ART
    printf '%b' "$C_OFF"
}

usage() {
    print_art
    cat <<EOF
  ppm $VERSION — Photon Package Manager (обёртка над apt)

  Использование: ppm <команда> [аргументы]

  Команды:
    install <пакеты>  установить пакеты             -> apt-get install
    remove  <пакеты>  удалить пакеты и сироты       -> apt-get remove + autoremove
    search  <запрос>  искать по репозиториям        -> apt-cache search
    info    <пакет>   подробности о пакете          -> apt-cache show
    sync              синхронизировать индексы репозиториев
    update            обновить систему целиком
    autoremove        удалить пакеты-сироты
    clean             очистить кэш скачанных пакетов
    list              список установленных пакетов
    about             о программе
    help              эта справка

  Синонимы: i=install  r=remove  s=search  up=update
  Аргументы передаются apt как есть: ppm install -t trixie-backports firefox

  Примеры:
    ppm sync && ppm update
    ppm install firefox fonts-noto-core
    ppm search terminal
EOF
}

about() {
    print_art
    printf '  ppm %s — Photon Package Manager\n' "$VERSION"
    printf '  PhotonOS | Debian (apt) | лицензия GPL-3.0\n'
    printf '  https://github.com/mel0k1/PhotonOS\n'
}

# ---------- команды ----------
[ $# -ge 1 ] || { usage; exit 0; }
CMD=$1
shift

case "$CMD" in
    install|i)
        need_apt
        need_root install
        [ $# -ge 1 ] || die "укажи пакеты: ppm install <пакеты>"
        msg "обновляю индексы репозиториев"
        apt-get update || warn "индексы не обновились — ставлю из локального кэша"
        msg "устанавливаю: $*"
        apt-get install "$@"
        exit $?
        ;;
    remove|r|rm)
        need_apt
        need_root remove
        [ $# -ge 1 ] || die "укажи пакеты: ppm remove <пакеты>"
        msg "удаляю: $*"
        apt-get remove "$@" || exit $?
        msg "убираю пакеты-сироты"
        apt-get autoremove
        exit $?
        ;;
    search|s)
        need_apt
        [ $# -ge 1 ] || die "укажи запрос: ppm search <запрос>"
        apt-cache search "$@"
        exit $?
        ;;
    info)
        need_apt
        [ $# -ge 1 ] || die "укажи пакет: ppm info <пакет>"
        apt-cache show "$@"
        exit $?
        ;;
    sync)
        need_apt
        need_root sync
        msg "синхронизирую индексы репозиториев"
        apt-get update
        exit $?
        ;;
    update|upgrade|up)
        need_apt
        need_root update
        msg "обновляю систему"
        apt-get update && apt-get full-upgrade
        exit $?
        ;;
    autoremove)
        need_apt
        need_root autoremove
        msg "удаляю пакеты-сироты"
        apt-get autoremove
        exit $?
        ;;
    clean)
        need_apt
        need_root clean
        msg "очищаю кэш скачанных пакетов"
        apt-get clean
        exit $?
        ;;
    list|ls)
        need_apt
        dpkg-query -W -f='${db:Status-Abbrev} ${binary:Package}\t${Version}\n' \
            | grep '^ii '
        exit $?
        ;;
    about|version|-v|--version)
        about
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        die "неизвестная команда: $CMD (справка: ppm help)"
        ;;
esac

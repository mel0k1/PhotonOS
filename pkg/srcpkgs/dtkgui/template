# Template file for 'dtkgui'
# Графическая прослойка DTK (темы, HiDPI, окна), Qt5-линия (5.7.30).
# librsvg — безусловный pkg_check; FreeImage/libraw опциональны и осознанно
# не включены (DTK_DISABLE_EX_IMAGE_FORMAT). Qt5WaylandClient и
# XkbCommonSupport дают qt5-wayland-devel и qt5-devel.
pkgname=dtkgui
version=5.7.30
revision=1
build_style=cmake
hostmakedepends="pkg-config qt5-qmake qt5-host-tools"
makedepends="dtkcore-devel qt5-devel qt5-x11extras-devel qt5-wayland-devel
 librsvg-devel wayland-devel libxkbcommon-devel libX11-devel libxcb-devel
 extra-cmake-modules"
short_desc="Графическая библиотека Deepin Tool Kit (DtkGui, Qt5)"
maintainer="mel0k1 <218306052+mel0k1@users.noreply.github.com>"
license="LGPL-3.0-or-later"
homepage="https://github.com/linuxdeepin/dtkgui"
distfiles="https://github.com/linuxdeepin/dtkgui/archive/refs/tags/${version}.tar.gz"
checksum=559682e5440212113af6effa724cd960a87b14f295e949dde80f15dde0f72a2a

dtkgui-devel_package() {
	depends="${makedepends} dtkgui>=${version}_${revision}"
	short_desc+=" - файлы разработки"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}

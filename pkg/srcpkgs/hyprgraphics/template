# Template file for 'hyprgraphics'
# Графическая утилитная библиотека Hyprland (загрузка/обработка изображений).
# Зависимости: libdrm pixman cairo pangocairo hyprutils libjpeg libwebp
# libmagic libpng librsvg; опциональные JXL/HEIF не включаем (не критично
# для MacShell, экономим цепочку сборки).
# SOVERSION 5 (libhyprgraphics.so.5) — см. pkg/shlibs-extra.txt.
pkgname=hyprgraphics
version=0.6.0
revision=1
build_style=cmake
configure_args="-DCMAKE_INSTALL_LIBDIR=lib"
hostmakedepends="pkg-config"
makedepends="hyprutils>=0.14.3 libdrm-devel pixman-devel cairo-devel pango-devel
 libjpeg-turbo-devel libwebp-devel libpng-devel librsvg-devel file file-devel"
short_desc="Hyprland graphics utilities library"
maintainer="mel0k1 <218306052+mel0k1@users.noreply.github.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprgraphics"
distfiles="https://github.com/hyprwm/hyprgraphics/archive/refs/tags/v${version}.tar.gz"
checksum=27e9e19ff59ba75a2963d72c3dcb5c0840b266b90d7fca6d5df7cac105419b08

post_install() {
	vlicense LICENSE
}

# Template file for 'photon-boot-splash'
# Загрузочная анимация PhotonOS: кадры фирменного видео (70 кадров, 15 fps)
# и скрипт-тема plymouth, зацикливающая их на всё время загрузки.
pkgname=photon-boot-splash
version=0.1.0
revision=1
depends="plymouth"
short_desc="Загрузочная тема plymouth PhotonOS"
maintainer="mel0k1 <218306052+mel0k1@users.noreply.github.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/mel0k1/PhotonOS"

do_install() {
	local t=usr/share/plymouth/themes/photon-boot
	vmkdir $t
	vinstall ${FILESDIR}/photon-boot/photon-boot.plymouth 644 $t
	vinstall ${FILESDIR}/photon-boot/photon-boot.script 644 $t
	for f in ${FILESDIR}/photon-boot/frame*.png; do
		vinstall "$f" 644 $t
	done
}

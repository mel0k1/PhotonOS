dbusmenu-qt5-devel_package() {
        short_desc+=" - файлы разработки"
        depends="qt5-devel ${sourcepkg}>=${version}_${revision}"
        pkg_install() {
                vmove usr/include
                vmove usr/lib/cmake
                vmove usr/lib/pkgconfig
                vmove "usr/lib/*.so"
        }
}

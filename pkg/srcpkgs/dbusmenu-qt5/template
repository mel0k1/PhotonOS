# Template file for 'dbusmenu-qt5'
# Qt5-реализация DBusMenu (libdbusmenu-qt, deepin-снапшот 16.04.20160218).
# Нужна dde-dock для меню иконок системного трея. В Void остались только
# glib/gtk-варианты, поэтому Qt5-библиотеку собираем сами.
pkgname=dbusmenu-qt5
version=0.9.3+16.04.20160218
revision=1
wrksrc="libdbusmenu-qt-0.9.3-16.04.20160218-deepin2"
build_style=cmake
configure_args="-DWITH_DOC=OFF -DCMAKE_INSTALL_LIBDIR=lib"
hostmakedepends="pkg-config"
makedepends="qt5-devel"
short_desc="Qt5-библиотека DBusMenu (libdbusmenu-qt)"
maintainer="mel0k1 <218306052+mel0k1@users.noreply.github.com>"

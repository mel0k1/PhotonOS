# Template file for 'deepin-wayland-protocols'
# Wayland-протоколы Deepin (deepin-* и kde-*), требуются DWayland и оболочке
# DDE. Использован тег 1.6.0-deepin.1.2 — последний, где ещё есть
# dde-globalproperty.xml, нужный dwayland (в новых тегах он удалён).
# Стандартные freedesktop-протоколы (xdg-shell, pointer-constraints и др.),
# которые dwayland ищет в этом каталоге, копируются из wayland-protocols
# Void, чтобы dde-dock/dwayland собирались без правок пути поиска.
pkgname=deepin-wayland-protocols
version=1.6.0
revision=2
_tag=1.6.0-deepin.1.2
wrksrc="${pkgname}-${_tag}"
build_style=cmake
configure_args="-DCMAKE_INSTALL_LIBDIR=lib"
hostmakedepends="pkg-config extra-cmake-modules"
makedepends="wayland-protocols"
short_desc="Набор wayland-протоколов Deepin (и стандартных для DDE)"
maintainer="mel0k1 <218306052+mel0k1@users.noreply.github.com>"
license="LGPL-2.1-or-later"
homepage="https://github.com/linuxdeepin/deepin-wayland-protocols"
distfiles="https://github.com/linuxdeepin/deepin-wayland-protocols/archive/refs/tags/${_tag}.tar.gz>deepin-wayland-protocols-${version}.tar.gz"
checksum=5a870dedc0f67338a977c52e13b472887958d666d787ebaee261d9aff1def124

post_install() {
	# Стандартные протоколы, запрашиваемые dwayland из DEEPIN_WAYLAND_PROTOCOLS_DIR
	local d=usr/share/deepin-wayland-protocols
	for f in \
		unstable/idle-inhibit/idle-inhibit-unstable-v1.xml \
		unstable/pointer-constraints/pointer-constraints-unstable-v1.xml \
		unstable/pointer-gestures/pointer-gestures-unstable-v1.xml \
		unstable/relative-pointer/relative-pointer-unstable-v1.xml \
		unstable/xdg-decoration/xdg-decoration-unstable-v1.xml \
		unstable/xdg-foreign/xdg-foreign-unstable-v2.xml \
		unstable/xdg-output/xdg-output-unstable-v1.xml \
		unstable/xdg-shell/xdg-shell-unstable-v6.xml \
		stable/xdg-shell/xdg-shell.xml; do
		vinstall /usr/share/wayland-protocols/$f 644 $d ${f##*/}
	done
}

version=0.6.0
revision=1
build_style=cmake
configure_args="-DCMAKE_INSTALL_LIBDIR=lib"
hostmakedepends="pkg-config hyprwayland-scanner"
makedepends="aquamarine hyprgraphics hyprutils hyprlang
 wayland-devel wayland-protocols libglvnd-devel pixman-devel libdrm-devel
 libgbm-devel libxkbcommon-devel pango-devel cairo-devel
 iniparser-devel abseil-cpp-devel"
short_desc="Wayland-native GUI toolkit from the Hyprland ecosystem"

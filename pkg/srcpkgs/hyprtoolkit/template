# Template file for 'hyprtoolkit'
# GUI-тулкит hyprwm (Wayland-native, C++23) — с 1.5.0 на нём работает
# xdg-desktop-portal-hyprland (портал требует hyprtoolkit>=0.6.0).
# В репозитории Void пакета нет. Публичные pkg-config-зависимости:
# aquamarine, hyprgraphics, hyprutils; приватные: wayland, egl, hyprlang,
# pixman, libdrm, gbm, xkbcommon, pango/cairo, iniparser, absl_flat_hash_map.
# SOVERSION 6 (libhyprtoolkit.so.6) — см. pkg/shlibs-extra.txt.

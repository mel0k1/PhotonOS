+// libstdc++14: нет std::formatter<std::vector<std::string>> (P2286) —
+// логируем список путей как joined-строку.
+static std::string HT_joinDirs(const std::vector<std::string>& v) {
+    std::string out;
+    for (const auto& s : v) {
+        if (!out.empty())
+            out += ": ";
+        out += s;
+    }
+    return out;
+}

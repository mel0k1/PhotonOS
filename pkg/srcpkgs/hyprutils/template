# Template file for 'hyprutils'
# Библиотека утилит экосистемы Hyprland. В Void осталась версия 0.11.0,
# а Hyprland 0.57 требует >= 0.14.3 — потому собираем свою.
# SOVERSION 13 (libhyprutils.so.13) — см. pkg/shlibs-extra.txt.
pkgname=hyprutils
version=0.14.3
revision=1
build_style=cmake
configure_args="-DCMAKE_INSTALL_LIBDIR=lib"
hostmakedepends="pkg-config"
makedepends="pixman-devel"
short_desc="Hyprland utilities library used across the ecosystem"
maintainer="mel0k1 <218306052+mel0k1@users.noreply.github.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprutils"
distfiles="https://github.com/hyprwm/hyprutils/archive/refs/tags/v${version}.tar.gz"

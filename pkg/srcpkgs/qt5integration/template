# Template file for 'qt5integration'
# Платформенная тема + стиль Dstyle + иконки/форматы DTK для Qt5
# (линия 5.7.30). Каталог исходников в тарболе — dde-qtintegration
# (upstream переименовал), поэтому wrksrc задан явно. Нужны приватные
# модули Qt5ThemeSupport (qt5-devel) и Qt5X11Extras.
pkgname=qt5integration
version=5.7.30
revision=1
wrksrc="dde-qtintegration-${version}"
build_style=cmake
configure_args="-DCMAKE_INSTALL_LIBDIR=lib -DBUILD_TESTING=OFF"
hostmakedepends="pkg-config extra-cmake-modules"
makedepends="qt5-devel qt5-x11extras-devel dtkcore-devel dtkgui-devel
 dtkwidget-devel dtkcommon mtdev-devel libX11-devel libxcb-devel"
# Платформенные плагины подтягиваются зависимостью qt5integration.
depends="qt5platform-plugins"
short_desc="Интеграция DTK в Qt5: тема, стиль, иконки, форматы"
maintainer="mel0k1 <218306052+mel0k1@users.noreply.github.com>"
license="LGPL-3.0-or-later"
homepage="https://github.com/linuxdeepin/qt5integration"
distfiles="https://github.com/linuxdeepin/qt5integration/archive/refs/tags/${version}.tar.gz"

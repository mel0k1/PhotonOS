Включение JournalAppender.h и объявление JournalAppender* безусловны,
хотя класс существует только в сборке dtklog с libsystemd
(BUILD_WITH_SYSTEMD). На runit-системах (Void/PhotonOS) libsystemd
отсутствует, заголовок не устанавливается — оборачиваем оба места тем
же стражем, что и использование в initJournalAppender(). Прокладывающий
заголовок DLog делаем самодостаточным через __has_include().
--- a/src/log/LogManager.cpp
+++ b/src/log/LogManager.cpp
@@ -8,7 +8,9 @@
 #include <Logger.h>
 #include <ConsoleAppender.h>
 #include <RollingFileAppender.h>
+#if defined BUILD_WITH_SYSTEMD && defined Q_OS_LINUX
 #include <JournalAppender.h>
+#endif

 #include "dstandardpaths.h"
 #include "dconfig_org_deepin_dtk_preference.hpp"
@@ -51,7 +53,9 @@
     QString m_logPath;
     ConsoleAppender* m_consoleAppender = nullptr;
     RollingFileAppender* m_rollingFileAppender = nullptr;
+#if defined BUILD_WITH_SYSTEMD && defined Q_OS_LINUX
     JournalAppender* m_journalAppender = nullptr;
+#endif
     QScopedPointer<dconfig_org_deepin_dtk_preference> m_dsgConfig;
     QScopedPointer<dconfig_org_deepin_dtk_preference> m_fallbackConfig;

--- a/include/DtkCore/DLog
+++ b/include/DtkCore/DLog
@@ -6,4 +6,6 @@
 #include <AbstractStringAppender.h>
 #include <AbstractAppender.h>
+#if __has_include(<JournalAppender.h>)
 #include <JournalAppender.h>
+#endif
 #include <dloghelper.h>

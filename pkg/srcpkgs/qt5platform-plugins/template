# Template file for 'qt5platform-plugins'
# QPA-плагины DTK (deepin xcb/wayland platform), Qt5-линия 5.7.30.
# Каталог исходников в тарболе — dde-qtplatform-plugins (upstream переименовал),
# поэтому wrksrc задан явно. Требует DtkBuildHelper (dtkcommon) и
# приватные заголовки Qt5 (входят в qt5-devel у Void).
pkgname=qt5platform-plugins
version=5.7.30
revision=1
wrksrc="dde-qtplatform-plugins-${version}"
build_style=cmake
configure_args="-DCMAKE_INSTALL_LIBDIR=lib -DBUILD_TESTING=OFF"
hostmakedepends="pkg-config extra-cmake-modules"
makedepends="qt5-devel qt5-x11extras-devel qt5-wayland-devel dtkcommon
 libX11-devel libxcb-devel xcb-util-image-devel xcb-util-wm-devel xcb-util-keysyms-devel xcb-util-renderutil-devel libXi-devel libSM-devel libICE-devel cairo-devel wayland-devel libxkbcommon-devel kwayland-devel"
short_desc="Платформенные QPA-плагины DTK для Qt5 (xcb, wayland)"
maintainer="mel0k1 <218306052+mel0k1@users.noreply.github.com>"
license="LGPL-3.0-or-later"
homepage="https://github.com/linuxdeepin/qt5platform-plugins"
distfiles="https://github.com/linuxdeepin/qt5platform-plugins/archive/refs/tags/${version}.tar.gz"
checksum=0f7eb589dcedb4b83a421fe255ec2076fc14c7a25e77abe21bc465fbe0277cbd

# Приватные заголовки QtXcb (5.15.11) вынесены в files/: upstream ищет
# xcb/libqt5xcbqpa-dev/<версия Qt>, а Void-овский qt5-devel их не ставит.
pre_configure() {
	cp -r $FILESDIR/qt5xcb-5.15.11 ${wrksrc}/xcb/libqt5xcbqpa-dev/5.15.11
}

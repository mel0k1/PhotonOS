# Template file for 'hyprland'
# Композитор Wayland с Lua-конфигом (0.55+) — база MacShell
# (менюбар/Dock/Spotlight в стиле macOS Tahoe, Quickshell).
# Hyprland 0.57 требует: aquamarine>=0.15 hyprlang>=0.6.7 hyprcursor>=0.1.7
# hyprutils>=0.14.3 hyprgraphics>=0.5.1 udis86>=1.7.2 glslang (config),
# glaze (иначе FetchContent из сети — в xbps-src запрещён), hyprland-protocols
# >=0.8, sdbus-c++>=2.0, xkbcommon, uuid, wayland-server, cairo, pango,
# pangocairo, pixman, xcursor, libdrm, libinput>=1.29, libeis-1.0, gbm,
# gio-2.0, re2, muparser, lcms2, libcanberra. XWayland-ветка: xcb, xcb-render,
# xcb-xfixes, xcb-icccm, xcb-composite, xcb-res, xcb-errors.
# cmake >= 3.30. mesa-dri — runtime (llvmpipe для VM / Mesa для GPU).

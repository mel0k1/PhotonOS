# Template file for 'glaze'
# Header-only JSON/бинарная сериализация. Hyprland 0.57: find_package(glaze QUIET),
# иначе FetchContent (сеть в xbps-src закрыта) — потому пакет обязателен.
# Ставим версию 7.2.0 — ровно та, что закреплена в Hyprland (GLAZE_VERSION).
pkgname=glaze
version=7.2.0
revision=1
build_style=cmake
# DEVELOPER_MODE у glaze по умолчанию ON при top-level сборке (cmake_dependent_option)
# — тянет CTest -> tests/CMakeLists -> FetchContent(ut) через git, которого в
# chroot нет. Явно выключаем: дистрибутивная сборка — только заголовки.
configure_args="-DCMAKE_INSTALL_LIBDIR=lib -Dglaze_BUILD_EXAMPLES=OFF
 -Dglaze_DEVELOPER_MODE=OFF -DBUILD_TESTING=OFF"
short_desc="Extremely fast, in-memory, JSON and interface library for modern C++"
maintainer="mel0k1 <218306052+mel0k1@users.noreply.github.com>"
license="MIT"
homepage="https://github.com/stephenberry/glaze"
distfiles="https://github.com/stephenberry/glaze/archive/refs/tags/v${version}.tar.gz"
checksum=17dba19ae63ae48f94994f00d49d5cb3c8f1306db1046c534c4828662490b7d4

post_install() {
        vlicense LICENSE
}

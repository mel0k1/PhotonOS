# Список пакетов live-образа PhotonOS.
# Формат: один пакет на строку, строки с # — комментарии.
# Ядро задаётся отдельно флагом -v linux-lts в build/build-iso.sh.

# база Void Linux: glibc, runit, xbps, elogind
base-system
sudo
nano
curl
git

# сеть
NetworkManager
network-manager-applet

# графика: Xorg + LXQt + стек оформления в духе Deepin
xorg
sddm
lxqt
pcmanfm-qt
qterminal
lximage-qt
lxqt-archiver
obconf-qt
lxqt-powermanagement
xdg-desktop-portal-lxqt

# оформление: плоский светлый стиль, тени/полупрозрачность
openbox
picom
papirus-icon-theme
arc-theme

# загрузочная анимация (тема photon-boot ставится оверлеем из pkg/)
plymouth

# шрифты и интеграция
noto-fonts-ttf
xdg-user-dirs

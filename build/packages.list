# Список пакетов live-образа PhotonOS.
# Формат: один пакет на строку, строки с # — комментарии.
# Ядро задаётся отдельно флагом -v linux-lts в build/build-iso.sh.

# база Void Linux: glibc, runit, xbps, elogind
base-system
sudo
nano
curl
git

# сеть
NetworkManager
network-manager-applet

# графика: Xorg + LXQt + стек оформления в духе Deepin
xorg
sddm
lxqt
pcmanfm-qt
qterminal
lximage-qt
lxqt-archiver
obconf-qt
lxqt-powermanagement
xdg-desktop-portal-lxqt

# оформление: плоский светлый стиль, тени/полупрозрачность
openbox
picom
papirus-icon-theme
arc-theme

# сессия MacShell (macOS Tahoe-стиль, docs/MACSHELL.md):
# hyprland/hyprlock/hypridle/portal — НАШИ пакеты из pkg/srcpkgs,
# попадают в ISO через локальный репозиторий (build/build-iso.sh);
# остальное — из репозитория Void.
hyprland
hyprlock
hypridle
xdg-desktop-portal-hyprland
quickshell
# программный Vulkan для Hyprland в VM (на живом железе — драйверы GPU)
mesa-vulkan-lavapipe
awww
kitty
cliphist
grim
slurp
wl-clipboard
wf-recorder
brightnessctl
inotify-tools
pipewire
wireplumber
playerctl
qt6ct
font-inter
noto-fonts-emoji
polkit-gnome
xdg-desktop-portal
xdg-desktop-portal-gtk
fastfetch

# загрузочная анимация (тема photon-boot ставится оверлеем из pkg/)
plymouth

# графический установщик (PySide6, docs/INSTALLER.md)
python3-pyside6
python3-pyside6-gui
python3-pyside6-widgets

# шрифты и интеграция
noto-fonts-ttf
xdg-user-dirs

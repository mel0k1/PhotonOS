# Список пакетов live-образа PhotonOS (база Debian, suite: trixie).
# Формат: один пакет на строку, строки с # — комментарии.
# База ставится mmdebstrap --variant=apt (essential + apt); здесь — всё остальное.

# ядро и live-механика
linux-image-amd64
live-boot
live-config
live-tools
initramfs-tools
zstd
# d-i-утилита создания live-юзера: без неё компонент user-setup live-config
# молча не отрабатывает (при --no-install-recommends не ставится сам)
user-setup

# загрузочная анимация photon-boot (тема ставится оверлеем из branding/)
plymouth
plymouth-label

# LXQt — ядро окружения, без метапакетов-мусора
lxqt-core
lxqt-panel
lxqt-runner
lxqt-session
lxqt-archiver
lxqt-powermanagement
lxqt-policykit
lxqt-sudo
pcmanfm-qt
pcmanfm-qt-l10n
qterminal
qterminal-l10n
lximage-qt
lximage-qt-l10n
openbox
obconf-qt
picom
xdg-desktop-portal-lxqt
xdg-desktop-portal-gtk

# дисплейный менеджер и сессия
sddm
xserver-xorg
xserver-xorg-video-all
xserver-xorg-input-libinput

# сеть
network-manager
network-manager-gnome
ca-certificates
curl

# оформление: LXQt-тема Onyxian-Rounded идёт оверлеем (/usr/share/lxqt/themes),
# Kvantum — движок виджетов (Orchis вендорится оверлеем в /usr/share/Kvantum)
papirus-icon-theme
arc-theme
qt6ct
qt6-style-kvantum
# ВНИМАНИЕ: qt6-svg-plugins (imageformats/libqsvg + iconengines) откатили:
# с ним lxqt-panel в TCG-окружении стартует окном 1x1 и не отрисовывается
# (3 прогона подряд; без пакета — панель живая). SVG-иконки меню мы и так
# не используем: кнопка меню — PNG (64x64 start-here-photon.png).
lxqt-themes
# переводы (ru): .qm-файлы лежат в отдельных -l10n пакетах, метапакеты их
# не тянут; без них при LANG=ru_RU UI остаётся английским
liblxqt-l10n
lxqt-panel-l10n
lxqt-runner-l10n
lxqt-session-l10n
lxqt-archiver-l10n
lxqt-powermanagement-l10n
lxqt-policykit-l10n
lxqt-sudo-l10n
obconf-qt-l10n
# управление GUI из серийной консоли (клики/клавиатура по X) — автотесты
xdotool
# X-диагностика live-сессии (xwininfo/xdpyinfo) — серийная отладка
x11-utils

# шрифты
fonts-noto-core
fonts-noto-color-emoji

# утилиты PhotonOS и базовые удобства
sudo
nano
xdg-user-dirs
dbus-x11
polkitd
pkexec
upower

# установщик: мастер на PyQt6 + бэкенд (sfdisk, GRUB EFI в /target)
# e2fsprogs не essential — variant=apt его не ставит, а mkfs.ext4 нужен и
# установщику, и fsck при загрузке установленной системы
e2fsprogs
python3-pyqt6
fdisk
efibootmgr
grub-efi-amd64

# инструменты сборки ISO (гостевые: isolinux, grub-efi, fat)
isolinux
syslinux-common
grub-efi-amd64-bin
dosfstools
mtools
pipewire
pipewire-pulse
wireplumber
login
qt6-image-formats-plugins
libqt6svg6
locales
dbus-user-session
